# CareerPilot Real-World API Keys & Environment Configuration
# Duplicate this file as .env and fill in your values
# In Vite applications, all browser-accessible variables MUST start with VITE_

# 1. RapidAPI Key (For real live Indian & global job openings via JSearch)
# Get your free key at: https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch
VITE_RAPIDAPI_KEY=

# 2. Google Gemini API Key (For AI PDF/DOCX resume text extraction)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# 3. Supabase Cloud Database (For permanent user & resume storage)
# Get your free credentials at: https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
